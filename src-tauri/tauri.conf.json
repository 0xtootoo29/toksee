{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokSee",
  "version": "0.1.3",
  "identifier": "com.toksee.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "TokSee",
        "width": 400,
        "height": 640,
        "minWidth": 400,
        "minHeight": 640,
        "maxWidth": 400,
        "maxHeight": 640,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": true,
        "fullscreen": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "frameworks": [],
      "signingIdentity": "-"
    }
  }
}
